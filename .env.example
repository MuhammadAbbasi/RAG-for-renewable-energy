# Copy this file to .env and adjust values as needed.
# All settings have sensible defaults — only override what you need to change.

# ── Ollama ──────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
VISION_MODEL=qwen2.5vl:latest
EMBED_MODEL=bge-m3:latest
EMBED_DIMENSION=1024

# ── Qdrant ──────────────────────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333

# ── Chunking ─────────────────────────────────────────────────────────────────
CHUNK_SIZE=512
CHUNK_OVERLAP=64
CHUNK_MIN_CHARS=80

# ── OCR ──────────────────────────────────────────────────────────────────────
OCR_LANGUAGE=it
OCR_DPI=300
SCANNED_TEXT_THRESHOLD=50

# ── Retrieval ─────────────────────────────────────────────────────────────────
RETRIEVAL_TOP_K=6
RETRIEVAL_SCORE_THRESHOLD=0.35

# ── Generation ────────────────────────────────────────────────────────────────
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=2048
LLM_CONTEXT_SIZE=8192

# ── API server ────────────────────────────────────────────────────────────────
API_HOST=0.0.0.0
API_PORT=8000

# ── Image captioning ──────────────────────────────────────────────────────────
IMAGE_MAX_DIM=1024
IMAGE_MIN_WIDTH=80
IMAGE_MIN_HEIGHT=80

# ── Indexing ──────────────────────────────────────────────────────────────────
FORCE_REINDEX=false
